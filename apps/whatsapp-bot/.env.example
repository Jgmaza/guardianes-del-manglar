# Copia este archivo a .env y completa con tu Twilio Console
# https://console.twilio.com

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token

# Sandbox suele verse así:
# whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Puerto del webhook local
PORT=3001

# true solo si el webhook público es HTTPS estable (ngrok/cloudflare)
TWILIO_VALIDATE_SIGNATURE=false

# API de reportes del monorepo (Next.js en apps/web, puerto 3000)
# Con esto, al terminar el triage el bot hace POST /api/v1/reports
REPORTS_API_URL=http://localhost:3000
