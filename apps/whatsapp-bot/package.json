{
  "name": "@guardianes/whatsapp-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WhatsApp bot + demo web de triage ambiental (Twilio sandbox / Baileys opcional)",
  "scripts": {
    "dev": "node bot/twilio-server.js",
    "bot": "node bot/twilio-server.js",
