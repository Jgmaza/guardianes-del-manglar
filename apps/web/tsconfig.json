{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "noEmit": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@guardianes/contracts": ["../../packages/contracts/src/index.ts"],
      "@guardianes/database": ["../../packages/database/src/index.ts"],
      "@guardianes/evidence-engine": ["../../packages/evidence-engine/src/index.ts"],
      "@guardianes/geo-engine": ["../../packages/geo-engine/src/index.ts"],
      "@guardianes/report-engine": ["../../packages/report-engine/src/index.ts"],
      "@guardianes/ui": ["../../packages/ui/src/index.ts"],
      "@guardianes/validation": ["../../packages/validation/src/index.ts"]
    },
    "verbatimModuleSyntax": true
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
