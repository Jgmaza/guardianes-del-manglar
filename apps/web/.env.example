# Copiar a apps/web/.env.local — nunca subir secretos

NEXT_PUBLIC_APP_NAME=Guardianes del Manglar
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ENABLE_SUPABASE=false

# Solo servidor — no prefijo NEXT_PUBLIC_
# Preferido. Si falta, con NEXT_PUBLIC_ENABLE_SUPABASE=true usa anon (solo sin RLS).
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DATABASE_POOLER_URL=

# reports API: supabase (default when public Supabase env is set) | memory
# REPORTS_PERSISTENCE=memory
