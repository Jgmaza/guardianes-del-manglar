# =============================================================================
# Guardianes del Manglar — variables de entorno (ejemplo)
# Copia a .env.local (apps/web) o .env en la raíz según el runtime.
# NUNCA commits de secretos reales.
# =============================================================================

# --- Público (exponible al navegador; SOLO claves publishable / anon) ---
NEXT_PUBLIC_APP_NAME=Guardianes del Manglar
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — URL del proyecto y clave anónima (RLS debe proteger datos)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Privado (solo servidor / CI — no usar prefijo NEXT_PUBLIC_) ---
# Service role: NUNCA en el cliente
SUPABASE_SERVICE_ROLE_KEY=

# Base de datos (opcional para scripts/tools; no exponer al browser)
DATABASE_URL=

# Feature flags de fundación
NEXT_PUBLIC_ENABLE_SUPABASE=false
