{
  "name": "@guardianes/geo-import",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "geo-import": "./src/cli.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "inspect": "python3 ./scripts/inspect_kml.py",
    "normalize": "tsx src/cli.ts normalize",
    "start:query-point": "tsx src/cli.ts query-point",
    "start:query-bbox": "tsx src/cli.ts query-bbox",
    "load-supabase": "node ./scripts/load-supabase.mjs",
    "import-invemar-zonificacion": "node ./scripts/import-invemar-zonificacion.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@guardianes/geo-engine": "workspace:*",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
